{
  "name": "ancher-radio",
  "version": "2.0.0",
  "description": "A code-built 3D table radio whose stations are your Ancher collections, playing shows Ancher writes from the connections between your saves.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 serve.py",
    "edition": "node engine/build.js",
    "edition:replay": "node engine/build.js --replay",
    "edition:demo": "node engine/build.js --demo",
    "road": "node engine/road.js",
    "test": "node --test engine/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ancher-ai/sdk": "^0.5.0",
    "three": "^0.186.1"
  }
}
